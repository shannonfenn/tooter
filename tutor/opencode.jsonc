// DEPLOYED tutor config — source of truth is tooter (workbench) tutor/opencode.jsonc.
// Edit there and run `just deploy`; direct edits in tooter-studies are overwritten
// and flagged by `just deploy --check`.
//
// Enforcement, not prose (redesign-plan.md §3.4): edit and bash are deny-by-default
// with narrow allowlists; the built-in SWE agents are disabled entirely.
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/math-study-context.md"],
  "share": "disabled",
  "default_agent": "math-pedagogy",
  "permission": {
    "edit": {
      "*": "deny",
      "studies/*/state/**": "allow",
      "studies/*/attempts/**": "allow",
      "studies/*/code/**": "ask"
    },
    "bash": {
      "*": "deny",
      "tooter-state *": "allow",
      "just *": "allow",
      "ls inbox": "allow",
      "ls inbox/*": "allow",
      // /start and /progress inject state via command templates; cat on pack
      // files adds nothing beyond the read tool the tutor already has.
      "cat studies/*": "allow"
    },
    "webfetch": "ask",
    "skill": {
      // last-match-wins: the built-in customize-opencode skill (registered in
      // code, cannot be unlisted) is hard-denied after the general "ask".
      "*": "ask",
      "customize-opencode": "deny"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    // The tutor spawns no subagents; general/explore carry non-pedagogy
    // default prompts, so they are disabled like build/plan.
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  }
}
